{
  "name": "exactly-once-billing",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b && tsc -p apps/web",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "crash-test": "tsx apps/crash-test/src/cli.ts",
    "dev": "pnpm --filter @eob/web dev",
    "build": "pnpm --filter @eob/web build"
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
